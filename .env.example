# Copy to .env (never commit .env). All values are optional until the step that needs them.

# --- Marketing API (direct REST fallback when the MCP server can't do a step) ---
# From your developer app at https://business-api.tiktok.com/portal (My Apps).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Long-term advertiser access token. If empty, `npm run auth:api` exchanges an
# auth_code and stores the token in .secrets/tokens.json (chmod 600) instead.
TIKTOK_ACCESS_TOKEN=

# --- Official TikTok for Business MCP server ---
# "flat" loads every tool up front; "layer" = progressive disclosure.
TIKTOK_MCP_URL=https://business-api.tiktok.com/open_mcp/tt-ads-mcp-flat
# Local port for the MCP OAuth browser callback (`npm run auth:mcp`).
TIKTOK_MCP_OAUTH_PORT=8765

# --- Safety ---
# Anything other than TT_WRITES_ENABLED=I_APPROVED_PUBLISHING keeps every write request in DRY RUN
# (logged, never sent). Do not change until Phase 7 is approved.
TT_WRITES_ENABLED=no
