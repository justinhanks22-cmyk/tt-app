# ─────────────────────────────────────────────────────────────────────────────
# Video Downloader configuration.
#   Docker Compose: copy to video-downloader/.env
#   Local dev:      the API reads ../.env and api/.env; the web app reads web/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED in production. Signs download links and keys the IP/session hashes.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me
# Shared secret between the Next.js proxy and the API (lets the API trust X-Client-IP).
INTERNAL_PROXY_TOKEN=change-me-too
ENVIRONMENT=development            # development | production

# ── Database ────────────────────────────────────────────────────────────────
# SQLite for local development, Postgres in production (Compose sets this itself).
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_PASSWORD=change-me        # used by docker-compose.yml only

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local              # local | s3
LOCAL_STORAGE_DIR=./data/files     # finished MP4s (local backend)
WORK_DIR=./data/work               # per-job temp dirs, always deleted after the job

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
S3_BUCKET=
S3_PREFIX=videos/
S3_REGION=auto                     # "auto" for R2; e.g. us-east-1 for AWS
S3_ENDPOINT_URL=                   # R2: https://<account-id>.r2.cloudflarestorage.com ; empty for AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=3600            # presigned links never outlive the file itself

# ── Lifetime ────────────────────────────────────────────────────────────────
FILE_TTL_HOURS=24                  # files are permanently deleted this long after creation
JOB_RECORD_RETENTION_HOURS=24      # expired/failed job rows are purged this long after that
CLEANUP_INTERVAL_SECONDS=300

# ── Limits & abuse protection ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=1024
MAX_DURATION_SECONDS=10800
PROCESSING_TIMEOUT_SECONDS=900
LOCATE_TIMEOUT_SECONDS=90
STORAGE_QUOTA_GB=20                # refuse new jobs when stored files would exceed this
MIN_FREE_DISK_MB=2048
MAX_QUEUE_LENGTH=50
RATE_LIMIT_JOBS_PER_HOUR=20        # per client IP (enforced in the database)
RATE_LIMIT_ACTIVE_JOBS=3           # concurrent jobs per client IP
RATE_LIMIT_REQUESTS_PER_MINUTE=120 # all API requests per client IP (per API instance)
ALLOW_HTTP=false                   # accept http:// links (https:// is always accepted)
ENABLE_OTHER_PLATFORMS=true        # Reddit, Vimeo, Dailymotion, Twitch, Streamable, Bluesky, Internet Archive
EXTRA_ALLOWED_DOMAINS=             # comma separated; must have a dedicated yt-dlp extractor
COOKIE_SECURE=false                # set true when served over HTTPS

# ── Worker ──────────────────────────────────────────────────────────────────
RUN_EMBEDDED_WORKER=true           # false when running `python -m app.worker_main` separately
WORKER_CONCURRENCY=2               # parallel jobs per worker process

# ── Media ───────────────────────────────────────────────────────────────────
VIDEO_COMPAT=modern                # modern: keep H.264/HEVC/VP9/AV1 as-is | h264: always H.264 (may re-encode)
X264_PRESET=veryfast               # only used when re-encoding
X264_CRF=18
YTDLP_JS_RUNTIME=auto              # auto | deno | node | none  (YouTube needs one)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Web (Next.js) ───────────────────────────────────────────────────────────
API_INTERNAL_URL=http://127.0.0.1:8000
TRUSTED_PROXY_HOPS=1               # reverse proxies in front of Next.js (Caddy = 1)

# ── Docker Compose ──────────────────────────────────────────────────────────
SITE_ADDRESS=:80                   # your domain (e.g. dl.example.com) enables automatic HTTPS
HTTP_PORT=8080
HTTPS_PORT=8443
